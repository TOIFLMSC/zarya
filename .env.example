# Configure these as environment variables. The application does not read .env automatically.
ZARYA_PORT=8787
# ZARYA_DATA_DIR=C:/path/to/private/zarya-data
# ZARYA_WEB_DIR=C:/path/to/web/dist
# ZARYA_DEV_UI=1  # Only for Vite development on http://127.0.0.1:5173
# CLI startup requires a local prompt bundle (copy src/zarya/prompts.example.json).
# ZARYA_PROMPTS_FILE=C:/path/to/private/prompts.json
# Telegram: environment takes precedence over data/telegram-token.txt.
# ZARYA_TELEGRAM_TOKEN=put-token-locally
# Without a token Telegram stays disabled. Never paste a real token into Git or chat.
# ZARYA_DEV_UI=1 disables Telegram reception even when a token is present.
# OpenAI: environment takes precedence over data/openai-api-key.txt.
# OPENAI_API_KEY=put-key-locally
# ZARYA_DEV_UI=1 also disables the real OpenAI adapter.
# Optional explicit paths; otherwise PATH or local .tools/ffmpeg/*/bin is used.
# ZARYA_FFMPEG=C:/tools/ffmpeg/bin/ffmpeg.exe
# ZARYA_FFPROBE=C:/tools/ffmpeg/bin/ffprobe.exe
